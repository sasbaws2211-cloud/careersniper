# Automatic HTTPS for the platform site, every tenant subdomain, and verified customer custom domains.
# Certificates are issued on first visit ("on demand"), but ONLY for hostnames the app approves at /internal/tls-allowed:
# the platform domain, existing tenant subdomains and custom domains whose ownership was verified. Arbitrary hostnames
# pointed at this server get no certificate, so nobody can use you to burn Let's Encrypt limits.
#
# Let's Encrypt allows 50 new certificates per week per registered domain. If you will onboard more than ~40 tenants a
# week, switch the tenant subdomains to ONE wildcard certificate (DNS challenge): see PRODUCTION.md, "Wildcard certificates".
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/internal/tls-allowed?key={$INTERNAL_TOKEN}
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy app:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# plain HTTP: redirect to HTTPS everywhere, except the ownership-proof file used when a customer verifies a custom domain
http:// {
	@proof path /.well-known/careersniper-verify.txt
	handle @proof {
		reverse_proxy app:8000
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
